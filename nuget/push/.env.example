# NuGet push profiles. Copy this file to .env and keep .env out of version control.
# Add more profiles by repeating this six-variable block with a unique uppercase ID.

# BEGIN NUGET PROFILE EXAMPLE
NUGET_PROFILE_EXAMPLE_NAME="Example package"
NUGET_PROFILE_EXAMPLE_PACKAGE_ID="Example.Messages"
NUGET_PROFILE_EXAMPLE_DIRECTORY="~/Projects/example/bin/Debug"
NUGET_PROFILE_EXAMPLE_SOURCE="https://api.nuget.org/v3/index.json"
NUGET_PROFILE_EXAMPLE_API_KEY="replace-me"
NUGET_PROFILE_EXAMPLE_SKIP_DUPLICATE="true"
# END NUGET PROFILE EXAMPLE
